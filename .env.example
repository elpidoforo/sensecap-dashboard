# Copy to .env for local use. On Railway, add these as service variables instead.
SENSECAP_API_ID=
SENSECAP_API_KEY=
# Optional: protect the dashboard with a password (any username)
DASHBOARD_PASSWORD=
# Optional: force demo data
# DEMO=1
# Student and team app (/app/)
# Secret to create the first admin at /app/#/staff. Remove it afterwards.
ADMIN_SETUP_CODE=
# Turns the Ask assistant on
ANTHROPIC_API_KEY=
# BOT_MODEL=claude-sonnet-5-5
# BOT_DAILY_LIMIT=40
# Ask is open to visitors (no sign-in). Limits per day unless noted; 0 switches that kind off.
# BOT_VISITOR_DAILY=30        per visitor (cookie)
# BOT_IP_DAILY=150            per network address
# BOT_IP_MINUTE=30            per network address per minute
# BOT_GLOBAL_DAILY=800        everybody together
# Hide the dashboard from people who are not signed in to the app
# LOCK_DASHBOARD=1
# Shared class sign-in (one user name and password for all students). Set both to switch it on.
# It locks the dashboard, map, 3D view and /cities/ behind that sign-in. Never commit the real values.
CLASS_LOGIN_USER=
CLASS_LOGIN_PASSWORD=
# Build studio limits (builds per day; 0 switches that kind off)
# STUDIO_SCHOOL_DAILY=25      per school, for class teams (class code + team name, no account)
# STUDIO_IP_DAILY=40          per network address, for class teams (a school behind one address shares it)
# STUDIO_GLOBAL_DAILY=300     everybody together
# STUDIO_DAILY_LIMIT=25       per signed-in person
# STUDIO_SCHOOL_PENDING=10    submitted pages per school waiting for a teacher
# STUDIO_TEAM_PLANS=12        team plans one class team may keep (plans waiting for a teacher share the STUDIO_SCHOOL_PENDING number, counted apart from tools)
# STUDIO_CLASS_SECRET=        optional signing secret for the class cookie (otherwise stored in the database)
# Vehicle positions shown to visitors (teachers who sign in see exact positions)
# PUBLIC_POS_DELAY_MIN=120    minutes a position is held back
# PUBLIC_POS_GRID=0.01        rounding in degrees (about 1 km)
