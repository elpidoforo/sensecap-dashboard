{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Cities source file (smartcities.source/1)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "summary",
    "layer",
    "publisher",
    "licence",
    "access",
    "coverage",
    "update",
    "variables",
    "quality",
    "added"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "$schema": {
      "type": "string",
      "description": "optional, e.g. ./_schema.json, lets editors validate as you type"
    },
    "schema": {
      "const": "smartcities.source/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200
    },
    "layer": {
      "enum": [
        "own",
        "official",
        "model",
        "context"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "degraded",
        "deprecated",
        "dead"
      ],
      "default": "candidate"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "publisher": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "kind": {
          "enum": [
            "government",
            "research",
            "community",
            "commercial",
            "own"
          ]
        }
      }
    },
    "licence": {
      "type": "object",
      "required": [
        "id",
        "checked_on"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "SPDX id, or LicenseRef-<name>, or 'unknown'"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "attribution": {
          "type": "string",
          "maxLength": 160
        },
        "commercial_use": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "share_alike": {
          "type": "boolean"
        },
        "checked_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "access": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "rest-json",
            "csv",
            "geojson",
            "ogc-api",
            "stac",
            "sensorthings",
            "ckan",
            "html",
            "file",
            "manual",
            "xml",
            "gtfs"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "docs_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "auth": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "api-key",
                "bearer",
                "basic",
                "oauth"
              ]
            },
            "env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "header": {
              "type": "string"
            },
            "param": {
              "type": "string"
            }
          }
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "per_minute": {
              "type": "integer"
            },
            "per_day": {
              "type": "integer"
            }
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "area",
        "bbox"
      ],
      "additionalProperties": false,
      "properties": {
        "area": {
          "type": "string",
          "maxLength": 80
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "resolution_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "period": {
          "type": "object",
          "required": [
            "start"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "update": {
      "type": "object",
      "required": [
        "every"
      ],
      "additionalProperties": false,
      "properties": {
        "every": {
          "type": "string",
          "pattern": "^(P[0-9TYMWDHS.]+|irregular|static)$",
          "description": "ISO 8601 duration, or irregular, or static"
        },
        "latency": {
          "type": "string",
          "pattern": "^P[0-9TYMWDHS.]+$"
        },
        "note": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "unit"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "unit": {
            "type": "string",
            "description": "UCUM code, e.g. ug/m3, Cel, %, hPa, [ppm]"
          },
          "kind": {
            "enum": [
              "measured",
              "modelled",
              "derived",
              "static"
            ]
          },
          "range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "max_step": {
            "type": "number",
            "description": "largest believable change between two consecutive readings"
          },
          "note": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "representativeness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": [
            "outdoor",
            "indoor",
            "vehicle",
            "mixed",
            "not-applicable"
          ]
        },
        "scale_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "size of area one value stands for"
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "reference-station",
            "calibrated-network",
            "low-cost-sensor",
            "crowd-sourced",
            "model",
            "reanalysis",
            "satellite",
            "survey",
            "statistics",
            "map",
            "unknown"
          ]
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 200
        },
        "known_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "stale_after": {
          "type": "string",
          "pattern": "^P[0-9TYMWDHS.]+$"
        }
      }
    },
    "upstream": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_id": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          }
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "GET"
        },
        "path": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "for_each": {
          "enum": [
            "places",
            "stations",
            "once"
          ]
        },
        "pagination": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "offset",
                "page",
                "cursor",
                "link"
              ]
            },
            "param": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            },
            "next_path": {
              "type": "string"
            }
          }
        },
        "response": {
          "type": "object",
          "required": [
            "format"
          ],
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": [
                "json",
                "csv",
                "geojson"
              ]
            },
            "records_path": {
              "type": "string"
            },
            "time_field": {
              "type": "string"
            },
            "series": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "variable id -> path or column in the response"
            },
            "missing": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "incremental": {
          "type": "object",
          "required": [
            "param"
          ],
          "additionalProperties": false,
          "properties": {
            "param": {
              "type": "string"
            },
            "cursor": {
              "type": "string"
            }
          }
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "expect": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "adapter": {
          "type": "string",
          "pattern": "^sources/adapters/[a-z0-9-]+\\.mjs$"
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "public"
      ],
      "additionalProperties": false,
      "properties": {
        "public": {
          "enum": [
            "full",
            "aggregate",
            "none"
          ]
        },
        "location_precision_m": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "agent_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_for": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 140
          }
        },
        "not_for": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 140
          }
        }
      }
    },
    "added": {
      "$ref": "#/$defs/stamp"
    },
    "checked": {
      "$ref": "#/$defs/stamp"
    },
    "notes": {
      "type": "string",
      "maxLength": 600
    },
    "planned": {
      "type": "boolean",
      "description": "true when someone has agreed to build the connection (shown as Planned, not Candidate)"
    },
    "tagline": {
      "type": "string",
      "maxLength": 70,
      "description": "short line under the name on the layer list, e.g. every 10 min"
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "el": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80
            },
            "summary": {
              "type": "string",
              "maxLength": 240
            },
            "tagline": {
              "type": "string",
              "maxLength": 70
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": {
            "const": "own"
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "required": [
          "privacy"
        ]
      }
    }
  ],
  "$defs": {
    "stamp": {
      "type": "object",
      "required": [
        "by",
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string"
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  },
  "$id": "smartcities.source/1"
}
